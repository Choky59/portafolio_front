# Backend URL in production (Heroku). Leave empty in dev: Vite proxies /api to localhost:3000
VITE_API_URL=

# Proyecto #3: game server close to the players (portafolio_back/deploy/juego), e.g.
# https://juego.example.com. Empty: the game uses the backend at VITE_API_URL
VITE_JUEGO_URL=

# Google Maps (map of El pulso). Public key: restrict it in Google Cloud to the site's domains
# (HTTP referrers, plus http://localhost:5173/* for dev) and to the Maps JavaScript API.
VITE_GOOGLE_MAPS_KEY=
# Optional Map ID (Google Cloud > Map management). Without it the map uses DEMO_MAP_ID (testing only)
VITE_GOOGLE_MAPS_MAP_ID=

# Header buttons
VITE_CV_URL=https://tu-cdn.com/jorge-garcia-cv.pdf
