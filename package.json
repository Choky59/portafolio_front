{
  "name": "portafolio-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:back": "npm --prefix ../portafolio_back run dev",
    "dev:full": "concurrently -n back,front -c yellow,cyan \"npm:dev:back\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "vite": "^8.0.0"
  }
}
